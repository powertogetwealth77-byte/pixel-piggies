{
  "name": "pixel-piggies",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pixel Piggies - a colorful color-matching launch puzzle game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:levels": "esbuild src/devcheck.ts --bundle --format=esm --outfile=node_modules/.cache/devcheck.mjs --log-level=error && node node_modules/.cache/devcheck.mjs",
    "test:e2e": "node scripts/e2e/e2e.mjs",
    "test:campaign": "node scripts/e2e/campaign.mjs",
    "test:tide": "node scripts/e2e/tide.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
